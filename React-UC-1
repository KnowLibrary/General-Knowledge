 * Database structural record for a dashboard view configuration.
 * @template TFilters The dynamic filter foot-print matching its host page.
 */
export interface SavedView<TFilters = Record<string, any>> {
  id: string;
  name: string;
  isSystemDefault?: boolean;
  

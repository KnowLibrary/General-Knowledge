  const [columnOrder, setColumnOrder] = useState<string[]>([]);
  const [committedFilters, setCommittedFilters] = useState<OrderFilters>(factoryInitialFilters);
  const [transientFilters, setTransientFilters] = useState<OrderFilters>(factoryInitialFilters);

  // Isolate current subType's valid system configs
  const views = useMemo(() => {
    return allViews.filter(v => v.screenName === 'ORDERS_PAGE' && v.subType === currentSubType);
  }, [allViews, currentSubType]);

  const activeView = useMemo(() => views.find(v => v.id === activeViewId), [views, activeViewId]);

  // Sync state layout defaults whenever a valid default view returns on initial mount
  useEffect(() => {
    if (activeView && Object.keys(columnVisibility).length === 0) {
      setCommittedFilters(activeView.filters);
      setTransientFilters(activeView.filters);
      setColumnVisibility(activeView.columnVisibility);
      setColumnOrder(activeView.columnOrder);
    }
  }, [activeView]);

  /**
   * Evaluates deep-equality to monitor if the working playground parameters match the pristine saved view
   */
  const isDirty = useMemo(() => {
    if (!activeView) return false;
    return (
      JSON.stringify(committedFilters) !== JSON.stringify(activeView.filters) ||
      JSON.stringify(columnVisibility) !== JSON.stringify(activeView.columnVisibility) ||
      JSON.stringify(columnOrder) !== JSON.stringify(activeView.columnOrder)
    );
  }, [committedFilters, columnVisibility, columnOrder, activeView]);

  // MANAGEMENT LAYER LOGIC METHODS
  const changeView = (viewId: string) => {
    const target = views.find(v => v.id === viewId);
    if (target) {
      setActiveViewId(viewId);
      setCommittedFilters(target.filters);
      setTransientFilters(target.filters);
      setColumnVisibility(target.columnVisibility);
      setColumnOrder(target.columnOrder);
    }
  };

  const changeSubType = (newSubType: string) => {
    setCurrentSubType(newSubType);
    setActiveViewId(null);
    setCommittedFilters(factoryInitialFilters);
    setTransientFilters(factoryInitialFilters);
    setColumnVisibility({});
    setColumnOrder([]);
  };

  const applyTransientFilters = () => setCommittedFilters(transientFilters);
  const resetTransientFilters = () => {
    setTransientFilters(factoryInitialFilters);
    setCommittedFilters(factoryInitialFilters);
  };

  const revertToSaved = () => {
    if (activeView) {
      setCommittedFilters(activeView.filters);
      setTransientFilters(activeView.filters);
      setColumnVisibility(activeView.columnVisibility);
      setColumnOrder(activeView.columnOrder);
    }
  };

  const saveCurrentView = async () => {
    if (!activeViewId) return;
    setAllViews(prev => prev.map(v => v.id === activeViewId 
      ? { ...v, filters: committedFilters, columnVisibility, columnOrder } : v
    ));
  };

  const createNewView = async (name: string) => {
    const nextId = `custom-${Date.now()}`;
    const newRecord: SavedView<OrderFilters> = {
      id: nextId,
      name,
      screenName: 'ORDERS_PAGE',
      subType: currentSubType,
      filters: committedFilters,
      columnVisibility,
      columnOrder
    };
    setAllViews(prev => [...prev, newRecord]);
    setActiveViewId(nextId);
  };

  const deleteView = async (id: string) => {
    setAllViews(prev => prev.filter(v => v.id !== id));
    if (activeViewId === id) {
      setActiveViewId(null);
      resetTransientFilters();
    }
  };

  const isLoading = viewsLoading || lookupsLoading;

  return (
    <DashboardContext.Provider value={{
      views, activeViewId, isDirty, currentSubType, changeSubType, committedFilters,
      columnVisibility, columnOrder, isLoading, transientFilters, setTransientFilters,
      dropdownOptions: lookups, changeView, applyTransientFilters, resetTransientFilters,
      saveCurrentView, revertToSaved, createNewView, deleteView, setColumnVisibility, setColumnOrder
    }}>
      {children}
    </DashboardContext.Provider>
  );
};

const useDashboard = () => {
  const context = useContext(DashboardContext);
  if (!context) throw new Error('Context boundaries error');
  return context;
};

// ============================================================================
// 4. GENERIC REUSABLE VIEW SELECTOR COMPONENT (ROW 1 UI SHELL)
// ============================================================================

interface ViewSelectorProps<T> {
  views: SavedView<T>[];
  activeViewId: string | null;
  isDirty: boolean;
  onViewChange: (viewId: string) => void;
  onSaveCurrentView: () => Promise<void>;
  onRevertChanges: () => void;
  onCreateViewSubmit: (name: string) => Promise<void>;
  onDeleteViewSubmit: (id: string) => Promise<void>;
}

function ViewSelector<T>({
  views, activeViewId, isDirty, onViewChange,
  onSaveCurrentView, onRevertChanges, onCreateViewSubmit, onDeleteViewSubmit
}: ViewSelectorProps<T>) {
  const [isOpen, setIsOpen] = useState(false);
  const activeView = views.find(v => v.id === activeViewId);
  const label = activeView ? `${activeView.name}${isDirty ? ' * (Unsaved)' : ''}` : 'Custom Filter Config';

  // Modal Input states
  const [showCreatePrompt, setShowCreatePrompt] = useState(false);
  const [showManagePrompt, setShowManagePrompt] = useState(false);
  const [newViewName, setNewViewName] = useState('');

  return (
    <div className="relative inline-flex items-center gap-3">
      <div className="relative">
        <button
          onClick={() => setIsOpen(!isOpen)}
          className={`px-4 py-2 text-sm font-medium border rounded-md shadow-sm flex items-center gap-2 ${
            isDirty ? 'bg-amber-50 border-amber-300 text-amber-800' : 'bg-white border-gray-300 text-gray-700'
          }`}
        >
          <span>{label}</span>
          <span className="text-xs">▼</span>
        </button>

        {isOpen && (
          <>
            <div className="fixed inset-0 z-10" onClick={() => setIsOpen(false)} />
            <div className="absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-md shadow-lg z-20 overflow-hidden">
              <div className="py-1 max-h-48 overflow-y-auto">
                {views.map(v => (
                  <button
                    key={v.id}
                    onClick={() => { onViewChange(v.id); setIsOpen(false); }}
                    className={`w-full text-left px-4 py-2 text-sm ${v.id === activeViewId ? 'bg-blue-50 text-blue-600 font-semibold' : 'text-gray-700 hover:bg-gray-100'}`}
                  >
                    {v.name}
                  </button>
                ))}
              </div>
              <div className="border-t border-gray-100 bg-gray-50 p-2 flex flex-col gap-1">
                <button 
                  onClick={() => { setShowCreatePrompt(true); setIsOpen(false); }}
                  className="text-left text-xs text-blue-600 hover:underline px-2 py-1 font-medium"
                >
                  + Create New View
                </button>
                <button 
                  onClick={() => { setShowManagePrompt(true); setIsOpen(false); }}
                  className="text-left text-xs text-gray-600 hover:underline px-2 py-1 font-medium"
                >
                  ⚙ Manage Saved Views
                </button>
              </div>
            </div>
          </>
        )}
      </div>

      {isDirty && (
        <div className="flex gap-2">
          <button onClick={onSaveCurrentView} className="px-3 py-1.5 bg-emerald-600 text-white rounded text-xs font-semibold hover:bg-emerald-700 transition">
            Save Changes
          </button>
          <button onClick={onRevertChanges} className="px-3 py-1.5 bg-white border border-gray-300 text-gray-700 rounded text-xs font-semibold hover:bg-gray-50 transition">
            Revert
          </button>
        </div>
      )}

      {/* MODAL 1: CREATE DIALOG BOX */}
      {showCreatePrompt && (
        <div className="fixed inset-0 bg-black/40 flex items-center justify-center z-50">
          <div className="bg-white p-6 rounded-lg shadow-xl w-80">
            <h3 className="font-bold text-sm mb-3 text-gray-800">Create New Layout Snapshot</h3>
            <input 
              type="text" placeholder="View Name" value={newViewName} 
              onChange={(e) => setNewViewName(e.target.value)}
              className="w-full border rounded p-2 text-sm mb-4 outline-none border-gray-300 focus:border-blue-500"
            />
            <div className="flex justify-end gap-2">
              <button onClick={() => setShowCreatePrompt(false)} className="px-3 py-1.5 text-xs font-semibold text-gray-600">Cancel</button>
              <button 
                onClick={() => { if(newViewName.trim()) { onCreateViewSubmit(newViewName); setShowCreatePrompt(false); setNewViewName(''); } }}
                className="px-3 py-1.5 text-xs font-semibold bg-blue-600 text-white rounded"
              >
                Create
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL 2: MANAGE VIEW LISTS */}
      {showManagePrompt && (
        <div className="fixed inset-0 bg-black/40 flex items-center justify-center z-50">
          <div className="bg-white p-6 rounded-lg shadow-xl w-80">
            <h3 className="font-bold text-sm mb-3 text-gray-800">Manage Views</h3>
            <div className="flex flex-col gap-2 max-h-40 overflow-y-auto mb-4">
              {views.map(v => (
                <div key={v.id} className="flex justify-between items-center text-sm p-1.5 border-b">
                  <span className="truncate max-w-[180px]">{v.name}</span>
                  {!v.isSystemDefault && (
                    <button onClick={() => onDeleteViewSubmit(v.id)} className="text-red-500 text-xs font-semibold hover:underline">Delete</button>
                  )}
                </div>
              ))}
            </div>
            <button onClick={() => setShowManagePrompt(false)} className="w-full py-1.5 text-xs font-semibold bg-gray-100 hover:bg-gray-200 rounded text-gray-700">Close</button>
          </div>
        </div>
      )}
    </div>
  );
}

// ============================================================================
// 5. INNER WORKSPACE COMPONENTS (ROW-BY-ROW PANELS)
// ============================================================================

function Row1ViewManagement() {
  const { views, activeViewId, isDirty, changeView, saveCurrentView, revertToSaved, createNewView, deleteView } = useDashboard();
  return (
    <div className="flex justify-between items-center bg-white p-4 border rounded-lg shadow-sm">
      <div>
        <h1 className="text-lg font-bold text-gray-800">Logistics Controls Portal</h1>
        <p className="text-xs text-gray-400 font-medium">Render operations across shared dynamic layout frameworks</p>
      </div>
      <ViewSelector
        views={views} activeViewId={activeViewId} isDirty={isDirty} onViewChange={changeView}
        onSaveCurrentView={saveCurrentView} onRevertChanges={revertToSaved} onCreateViewSubmit={createNewView} onDeleteViewSubmit={deleteView}
      />
    </div>
  );
}

function Row2FilterBar() {
  const { transientFilters, setTransientFilters, applyTransientFilters, resetTransientFilters, dropdownOptions } = useDashboard();

  return (
    <div className="bg-gray-50 border border-gray-200 rounded-lg p-4 flex flex-wrap items-center justify-between gap-4">
      <div className="flex items-center gap-4">
        {/* Status Handling Selection */}
        <div className="flex flex-col gap-1">
          <label className="text-xs font-bold text-gray-500">Order Stage Filter</label>
          <select
            className="border border-gray-300 rounded p-1.5 text-xs bg-white min-w-[150px]"
            value={transientFilters.status[0] || ''}
            onChange={(e) => {
              const val = e.target.value;
              setTransientFilters(prev => ({ ...prev, status: val ? [val as any] : [] }));
            }}
          >
            <option value="">All Standard Stages</option>
            {dropdownOptions.statuses.map(opt => (
              <option key={opt.value} value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>

        {/* Numeric Filtering Input */}
        <div className="flex flex-col gap-1">
          <label className="text-xs font-bold text-gray-500">Min Line-Value ($)</label>
          <input
            type="number" className="border border-gray-300 rounded p-1 text-xs w-28 h-[28px]"
            value={transientFilters.minAmount}
            onChange={(e) => setTransientFilters(prev => ({ ...prev, minAmount: Number(e.target.value) }))}
          />
        </div>
      </div>

      <div className="flex items-center gap-2">
        <button onClick={resetTransientFilters} className="text-xs font-bold text-gray-500 hover:text-gray-800 py-2 px-3">
          Reset
        </button>
        <button onClick={applyTransientFilters} className="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-1.5 px-4 rounded shadow-sm transition">
          Apply Filters
        </button>
      </div>
    </div>
  );
}

function Row3DataTable() {
  const { currentSubType, committedFilters, columnVisibility, setColumnVisibility, columnOrder, setColumnOrder } = useDashboard();
  
  // Dynamic network records hook
  const { rows, rowsLoading } = useFetchOrdersGridRows(currentSubType, committedFilters);

  // Material React Table Column Framework Blueprint Definitions
  const columns = useMemo<MRT_ColumnDef<OrderRowItem>[]>(() => [
    { accessorKey: 'id', header: 'Internal ID' },
    { accessorKey: 'trackingNumber', header: 'Waybill Number' },
    { accessorKey: 'amount', header: 'Evaluation Value', Cell: ({ cell }) => `$${cell.getValue<number>().toLocaleString()}` },
    { accessorKey: 'status', header: 'Pipeline Status' },
  ], []);

  const table = useMaterialReactTable({
    columns,
    data: rows,
    enableColumnOrdering: true,
    enableColumnDragging: true,
    state: {
      isLoading: rowsLoading,
      columnVisibility,
      columnOrder,
    },
    onColumnVisibilityChange: setColumnVisibility,
    onColumnOrderChange: setColumnOrder,
    initialState: { density: 'compact' },
  });

  return (
    <div className="border border-gray-200 rounded-lg overflow-hidden bg-white shadow-sm">
      <MaterialReactTable table={table} />
    </div>
  );
}


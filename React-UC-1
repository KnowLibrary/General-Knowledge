2. Setting Up the Page Context & Provider
Because React Context requires an initial value or explicit typing, we can't create a truly "dynamic" global context without sacrificing type safety. Instead, the cleanest architectural pattern is to create a Context Creator Function or instantiate a cleanly typed context per feature folder.
Here is how a specific page (e.g., an Orders Dashboard) initializes this generic structure.
TypeScript
// features/orders/context/OrdersDashboardContext.tsx
import React, { createContext, useContext, useState, useMemo, useEffect } from 'react';
import { DashboardContextState } from '@/types/dashboardContext';
import { SavedView } from '@/types/view';

// 1. Define this specific page's unique filter footprint
export interface OrderFilters {
  status: ('pending' | 'shipped' | 'cancelled')[];
  dateRange: { start: string | null; end: string | null };
  minAmount: number;
}

// Default factory configurations for this page
const initialFilters: OrderFilters = {
  status: [],
  dateRange: { start: null, end: null },
  minAmount: 0,
};

// 2. Create the Context with the OrderFilters parameter
const OrdersDashboardContext = createContext<DashboardContextState<OrderFilters> | undefined>(undefined);

export const OrdersDashboardProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  // DB State
  const [views, setViews] = useState<SavedView<OrderFilters>[]>([]);
  const [activeViewId, setActiveViewId] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  // Layout States (Directly tied to Material-React-Table)
  const [columnVisibility, setColumnVisibility] = useState<Record<string, boolean>>({});
  const [columnOrder, setColumnOrder] = useState<string[]>([]);

  // Filter States (Committed vs Transient)
  const [committedFilters, setCommittedFilters] = useState<OrderFilters>(initialFilters);
  const [transientFilters, setTransientFilters] = useState<OrderFilters>(initialFilters);

  // 3. Find the current matching active view configuration
  const activeView = useMemo(() => views.find(v => v.id === activeViewId), [views, activeViewId]);

  // 4. Derived "isDirty" State Engine (Compares layout & filters to original view)
  const isDirty = useMemo(() => {
    if (!activeView) return false;
    return (
      JSON.stringify(committedFilters) !== JSON.stringify(activeView.filters) ||
      JSON.stringify(columnVisibility) !== JSON.stringify(activeView.columnVisibility) ||
      JSON.stringify(columnOrder) !== JSON.stringify(activeView.columnOrder)
    );
  }, [committedFilters, columnVisibility, columnOrder, activeView]);

  // --- Handlers & Orchestration ---

  const changeView = (viewId: string) => {
    const targetView = views.find(v => v.id === viewId);
    if (targetView) {
      setActiveViewId(viewId);
      setCommittedFilters(targetView.filters);
      setTransientFilters(targetView.filters); // Sync dropdown transient UI
      setColumnVisibility(targetView.columnVisibility);
      setColumnOrder(targetView.columnOrder);
    }
  };

  const applyTransientFilters = () => {
    setCommittedFilters(transientFilters); // Flushes changes to Table/API query
  };

  const resetTransientFilters = () => {
    setTransientFilters(initialFilters);
    setCommittedFilters(initialFilters);
  };

  const revertToSaved = () => {
    if (activeView) {
      setCommittedFilters(activeView.filters);
      setTransientFilters(activeView.filters);
      setColumnVisibility(activeView.columnVisibility);
      setColumnOrder(activeView.columnOrder);
    }
  };

  const saveCurrentView = async () => {
    if (!activeViewId) return;
    // Mock API call saving current configuration to the server
    // await api.put(`/views/${activeViewId}`, { committedFilters, columnVisibility, columnOrder });
    
    // Update local context array state to match server update
    setViews(prev => prev.map(v => v.id === activeViewId 
      ? { ...v, filters: committedFilters, columnVisibility, columnOrder } 
      : v
    ));
  };

  const createNewView = async (name: string) => {
    const newViewPayload: SavedView<OrderFilters> = {
      id: Math.random().toString(), // typically backend driven
      name,
      filters: committedFilters,
      columnVisibility,
      columnOrder
    };
    // await api.post('/views', newViewPayload);
    setViews(prev => [...prev, newViewPayload]);
    setActiveViewId(newViewPayload.id);
  };

  const deleteView = async (id: string) => {
    // await api.delete(`/views/${id}`);
    setViews(prev => prev.filter(v => v.id !== id));
    if (activeViewId === id) {
      setActiveViewId(null);
      setCommittedFilters(initialFilters);
      setTransientFilters(initialFilters);
    }
  };

  return (
    <OrdersDashboardContext.Provider value={{
      views, activeViewId, isDirty, committedFilters, columnVisibility, columnOrder,
      transientFilters, setTransientFilters, isLoading, changeView, applyTransientFilters,
      resetTransientFilters, saveCurrentView, revertToSaved, createNewView, deleteView,
      setColumnVisibility, setColumnOrder
    }}>
      {children}
    </OrdersDashboardContext.Provider>
  );
};

// 5. Export a strictly typed hook unique to this feature
export const useOrdersDashboard = () => {
  const context = useContext(OrdersDashboardContext);
  if (!context) throw new Error('useOrdersDashboard must be used within an OrdersDashboardProvider');
  return context;
};

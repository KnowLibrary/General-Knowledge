2. Adapting the Context API
When a page does support sub-types, changing the sub-type must swap out the available list of views, reset the columns, and clear the filters.
We expand the generic context interface to include an optional subType state tracker.
TypeScript
// types/dashboardContext.ts
import { SavedView } from './view';

export interface DashboardContextState<F> {
  // Views Array & Global Filters
  allViews: SavedView<F>[];          // ALL views for this screen name
  views: SavedView<F>[];             // FILTERED views matching the current subType
  activeViewId: string | null;
  isDirty: boolean;
  
  // Sub-Type Strategy (Optional Tier)
  currentSubType?: string;           // Present if the page has sub-flavors
  changeSubType?: (newSubType: string) => void; 

  // Committed Layout States
  committedFilters: F;
  columnVisibility: Record<string, boolean>;
  columnOrder: string[];
  isLoading: boolean;

  // Transient States
  transientFilters: F;
  setTransientFilters: React.Dispatch<React.SetStateAction<F>>;

  // Shared Modals & Layout Actions
  changeView: (viewId: string) => void;
  applyTransientFilters: () => void;
  resetTransientFilters: () => void;
  saveCurrentView: () => Promise<void>;
  revertToSaved: () => void;
  createNewView: (name: string) => Promise<void>;
  deleteView: (id: string) => Promise<void>;
  setColumnVisibility: React.Dispatch<React.SetStateAction<Record<string, boolean>>>;
  setColumnOrder: React.Dispatch<React.SetStateAction<string[]>>;
}

/**
 * Database structural record for a dashboard view configuration snapshot.
 * @template TFilters The dynamic filter layout matching its host dashboard page.
 */
interface SavedView<TFilters = Record<string, any>> {
  id: string;
  name: string;
  screenName: string;
  subType?: string;
  isSystemDefault?: boolean;
  filters: TFilters;

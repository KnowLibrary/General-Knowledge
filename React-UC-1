2. Incorporating the Modals globally into <ViewSelector />
By keeping modal toggle flags inside the <ViewSelector /> itself, we completely hide the popup open/close state management away from your individual pages.
TypeScript
// components/shared/views/ViewSelector.tsx
import { useState } from 'react';
import { SavedView } from '@/types/view';
import { CreateViewModal } from './CreateViewModal';
import { ManageViewsModal } from './ManageViewsModal';

interface ViewSelectorProps<T> {
  views: SavedView<T>[];
  activeViewId: string | null;
  isDirty: boolean;
  onViewChange: (viewId: string) => void;
  onSaveCurrentView: () => void;
  onRevertChanges: () => void;
  
  // Handlers for the internal shared modals
  onCreateViewSubmit: (name: string) => Promise<void>;
  onDeleteViewSubmit: (id: string) => Promise<void>;
}

export function ViewSelector<T>({
  views, activeViewId, isDirty,
  onViewChange, onSaveCurrentView, onRevertChanges,
  onCreateViewSubmit, onDeleteViewSubmit
}: ViewSelectorProps<T>) {
  const [isCreateOpen, setIsCreateOpen] = useState(false);
  const [isManageOpen, setIsManageOpen] = useState(false);

  const activeView = views.find((v) => v.id === activeViewId);
  const dropdownLabel = activeView ? `${activeView.name}${isDirty ? ' *' : ''}` : 'Select View';

  return (
    <>
      <div className="flex items-center gap-3">
        <Dropdown menuLabel={dropdownLabel}>
          <DropdownGroup>
            {views.map((v) => (
              <DropdownItem key={v.id} isActive={v.id === activeViewId} onClick={() => onViewChange(v.id)}>
                {v.name}
              </DropdownItem>
            ))}
          </DropdownGroup>
          <DropdownDivider />
          <DropdownFooter>
            {/* These action links simply trigger internal modal states */}
            <DropdownFooterLink onClick={() => setIsCreateOpen(true)}>Create New View</DropdownFooterLink>
            <DropdownFooterLink onClick={() => setIsManageOpen(true)}>Manage Views</DropdownFooterLink>
          </DropdownFooter>
        </Dropdown>

        {isDirty && (
          <div className="flex gap-2">
            <Button onClick={onSaveCurrentView} variant="primary" size="sm">Save Changes</Button>
            <Button onClick={onRevertChanges} variant="secondary" size="sm">Revert</Button>
          </div>
        )}
      </div>

      {/* Global Shared Modals encapsulated here */}
      <CreateViewModal 
        isOpen={isCreateOpen} 
        onClose={() => setIsCreateOpen(false)} 
        onConfirmCreate={onCreateViewSubmit} 
      />
      <ManageViewsModal 
        isOpen={isManageOpen} 
        onClose={() => setIsManageOpen(false)} 
        views={views} 
        onDeleteView={onDeleteViewSubmit} 
      />
    </>
  );
}

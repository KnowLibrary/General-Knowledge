import React, { useState } from 'react';
import { SavedView } from '@/types/view';
import { CreateViewModal } from './CreateViewModal';
import { ManageViewsModal } from './ManageViewsModal';

interface ViewSelectorProps<T> {
  // Core Array Data
  views: SavedView<T>[];
  activeViewId: string | null;
  isDirty: boolean;
  
  // Basic Event Emitters
  onViewChange: (viewId: string) => void;
  onSaveCurrentView: () => Promise<void> | void;
  onRevertChanges: () => void;
  
  // API Integration Triggers passed from Page Context
  onCreateViewSubmit: (name: string) => Promise<void>;
  onDeleteViewSubmit: (id: string) => Promise<void>;
}

export function ViewSelector<T>({
  views,
  activeViewId,
  isDirty,
  onViewChange,
  onSaveCurrentView,
  onRevertChanges,
  onCreateViewSubmit,
  onDeleteViewSubmit,
}: ViewSelectorProps<T>) {
  // 1. Local UI visibility flags for encapsulated popups
  const [isDropdownOpen, setIsDropdownOpen] = useState(false);
  const [isCreateOpen, setIsCreateOpen] = useState(false);
  const [isManageOpen, setIsManageOpen] = useState(false);
  const [isSaving, setIsSaving] = useState(false);

  // 2. Identify current active layout context metadata
  const activeView = views.find((v) => v.id === activeViewId);
  
  // Append dirty indicator to view text label dynamically
  const displayLabel = activeView 
    ? `${activeView.name}${isDirty ? ' *' : ''}` 
    : 'Select Dashboard View';

  const handleSaveClick = async () => {
    setIsSaving(true);
    try {
      await onSaveCurrentView();
    } catch (err) {
      console.error('Failed to update current view configuration profile:', err);
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <div className="relative inline-flex items-center gap-3">
      
      {/* DROPDOWN SELECTOR ENGINE */}
      <div className="relative">
        <button
          type="button"
          onClick={() => setIsDropdownOpen((prev) => !prev)}
          className={`inline-flex items-center justify-between min-w-[220px] px-4 py-2 text-sm font-medium border rounded-md shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 ${
            isDirty 
              ? 'border-amber-300 bg-amber-50 text-amber-900 hover:bg-amber-100' 
              : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
          }`}
        >
          <span className="truncate">{displayLabel}</span>
          <svg className="w-4 h-4 ml-2 -mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        {isDropdownOpen && (
          <>
            {/* Backdrop click overlay closer */}
            <div className="fixed inset-0 z-10" onClick={() => setIsDropdownOpen(false)} />
            
            <div className="absolute right-0 w-64 mt-2 origin-top-right bg-white border border-gray-200 rounded-md shadow-xl z-20 focus:outline-none overflow-hidden animate-fade-in">
              {/* SAVED VIEW ITERATION REGION */}
              <div className="max-h-60 overflow-y-auto py-1">
                {views.length === 0 ? (
                  <p className="px-4 py-3 text-xs italic text-gray-400 text-center">No views registered</p>
                ) : (
                  views.map((view) => (
                    <button
                      key={view.id}
                      type="button"
                      onClick={() => {
                        onViewChange(view.id);
                        setIsDropdownOpen(false);
                      }}
                      className={`flex items-center justify-between w-full text-left px-4 py-2.5 text-sm transition-colors ${
                        view.id === activeViewId
                          ? 'bg-blue-50 text-blue-900 font-semibold'
                          : 'text-gray-700 hover:bg-gray-50'
                      }`}
                    >
                      <span className="truncate">{view.name}</span>
                      {view.id === activeViewId && (
                        <svg className="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                        </svg>
                      )}
                    </button>
                  ))
                )}
              </div>

              {/* BOUNDARY FOOTER ACTIONS PANEL */}
              <div className="border-t border-gray-100 bg-gray-50 px-2 py-1.5 flex flex-col gap-0.5">
                <button
                  type="button"
                  onClick={() => {
                    setIsCreateOpen(true);
                    setIsDropdownOpen(false);
                  }}
                  className="flex w-full items-center px-3 py-1.5 text-xs font-medium text-blue-600 hover:bg-blue-100 hover:text-blue-700 rounded transition"
                >
                  <svg className="w-3.5 h-3.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4v16m8-8H4" />
                  </svg>
                  Create New View
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setIsManageOpen(true);
                    setIsDropdownOpen(false);
                  }}
                  className="flex w-full items-center px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-200 hover:text-gray-900 rounded transition"
                >
                  <svg className="w-3.5 h-3.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Manage System Views
                </button>
              </div>
            </div>
          </>
        )}
      </div>

      {/* TRANSACTION STATE ACTION TRIGGER REGION */}
      {isDirty && (
        <div className="flex items-center gap-2 animate-fade-in">
          <button
            type="button"
            disabled={isSaving}
            onClick={handleSaveClick}
            className="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded shadow-sm text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 disabled:opacity-50 transition"
          >
            {isSaving ? 'Saving...' : 'Save Changes'}
          </button>
          <button
            type="button"
            disabled={isSaving}
            onClick={onRevertChanges}
            className="inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 transition"
          >
            Revert
          </button>
        </div>
      )}

      {/* PORTAL CAPSULED POPUPS */}
      <CreateViewModal
        isOpen={isCreateOpen}
        onClose={() => setIsCreateOpen(false)}
        onConfirmCreate={onCreateViewSubmit}
      />

      <ManageViewsModal
        isOpen={isManageOpen}
        onClose={() => setIsManageOpen(false)}
        views={views}
        onDeleteView={onDeleteViewSubmit}
      />

    </div>
  );
}

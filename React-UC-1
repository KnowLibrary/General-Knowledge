export interface SavedView<TFilters = Record<string, any>> {
  id: string;
  name: string;
  screenName: string;         // Identifies the main page (e.g., "ORDERS_PAGE")
  subType?: string;           // Optional sub-flavor (e.g., "B2B_ORDERS" vs "B2C_ORDERS")
  isSystemDefault?: boolean;
  
  // Layout Payloads
  filters: TFilters;
  columnVisibility: Record<string, boolean>;
  columnOrder: string[];
}

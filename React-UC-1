3. useFetchOrdersGridRows.ts (Row 3 Table Data Engine)
This hook is decoupled from the initial page setup. It watches only committedFilters (and subType), remaining completely unbothered by column drags, row clicks, or un-applied changes inside the filter drop-downs.
TypeScript
// features/orders/hooks/useFetchOrdersGridRows.ts
import { useState, useEffect } from 'react';
import { OrderFilters } from '../context/OrdersDashboardContext';

export interface OrderRowItem {
  id: string;
  trackingNumber: string;
  amount: number;
  status: string;
}

export function useFetchOrdersGridRows(subType: string, committedFilters: OrderFilters) {
  const [rows, setRows] = useState<OrderRowItem[]>([]);
  const [rowsLoading, setRowsLoading] = useState<boolean>(false);

  useEffect(() => {
    let isMounted = true;

    async function fetchGridDataset() {
      setRowsLoading(true);
      try {
        // Constructing request parameters based explicitly on committed values
        const queryParams = new URLSearchParams({
          subType,
          status: (committedFilters.status || []).join(','),
          minAmount: String(committedFilters.minAmount || 0)
        });

        // Example execution framework target:
        // const response = await api.get(`/api/v1/orders?${queryParams.toString()}`);
        
        await new Promise((resolve) => setTimeout(resolve, 800));

        // Generated localized payload sets matching requested constraints
        const mockRows: OrderRowItem[] = [
          { id: '101', trackingNumber: 'TRK-B2B-9921', amount: 4500, status: 'pending' },
          { id: '102', trackingNumber: 'TRK-B2B-4512', amount: 12000, status: 'shipped' },
          { id: '103', trackingNumber: 'TRK-B2B-0081', amount: 150, status: 'pending' }
        ].filter(item => {
          // Local filter simulation matches query inputs
          const statusMatch = committedFilters.status?.length ? committedFilters.status.includes(item.status as any) : true;
          const amountMatch = item.amount >= (committedFilters.minAmount || 0);
          return statusMatch && amountMatch;
        });

        if (isMounted) {
          setRows(mockRows);
        }
      } catch (err) {
        console.error('Failed to secure datagrid parameters:', err);
      } finally {
        if (isMounted) setRowsLoading(false);
      }
    }

    fetchGridDataset();

    return () => {
      isMounted = false;
    };
    // CRITICAL PERFORMANCE GUARD: 
    // This effect runs ONLY when committedFilters snapshot or subType transitions.
  }, [subType, committedFilters]); 

  return { rows, rowsLoading };
}

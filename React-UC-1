  statuses: { value: string; label: string }[];
}

/**
 * Data shape representing individual row records displayed inside the grid.
 */
interface OrderRowItem {
  id: string;
  trackingNumber: string;
  amount: number;
  status: string;
}

/**
 * Master interface managing structural state distribution across rows 1, 2, and 3.
 */

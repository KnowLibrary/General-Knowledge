/**
 * Hook 1: Fetches saved configurations matching the page screen configuration.
 */
function useFetchPageViews(screenName: string) {
  const [allViews, setAllViews] = useState<SavedView<OrderFilters>[]>([]);
  const [viewsLoading, setViewsLoading] = useState(true);

  useEffect(() => {
    async function loadViews() {
      await new Promise((resolve) => setTimeout(resolve, 500)); // Latency Simulation
      setAllViews([

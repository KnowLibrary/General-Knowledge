          id: 'v1',
          name: 'Standard Pipeline',
          screenName: 'ORDERS_PAGE',
          subType: 'B2B_ORDERS',
          isSystemDefault: true,
          filters: { status: ['pending'], minAmount: 500 },
          columnVisibility: { id: true, trackingNumber: true, amount: true, status: true },
          columnOrder: ['id', 'trackingNumber', 'amount', 'status']
        },
        {
          id: 'v2',
          name: 'High-Value Executions',
          screenName: 'ORDERS_PAGE',
          subType: 'B2B_ORDERS',
          filters: { status: ['pending', 'shipped'], minAmount: 5000 },
          columnVisibility: { id: true, amount: true, status: true },
          columnOrder: ['id', 'amount', 'status']
        }
      ]);
      setViewsLoading(false);
    }
    loadViews();
  }, [screenName]);

  return { allViews, setAllViews, viewsLoading };
}

/**
 * Hook 2: Fetches static metadata options displayed inside structural filter inputs.
 */
function useFetchOrdersLookups(subType: string) {
  const [lookups, setLookups] = useState<FilterLookups>({ statuses: [] });
  const [lookupsLoading, setLookupsLoading] = useState(true);


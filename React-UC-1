    }
    loadMetadata();
  }, [subType]);

  return { lookups, lookupsLoading };
}

/**
 * Hook 3: Handles dynamic table rows query parameters. Reactive ONLY to committed actions.
 */
function useFetchOrdersGridRows(subType: string, committedFilters: OrderFilters) {
  const [rows, setRows] = useState<OrderRowItem[]>([]);
  const [rowsLoading, setRowsLoading] = useState(false);

  useEffect(() => {
    async function fetchDataset() {
      setRowsLoading(true);
      await new Promise((resolve) => setTimeout(resolve, 600)); // Network simulation
      
      const staticMockDatabase: OrderRowItem[] = [
        { id: '101', trackingNumber: 'TRK-B2B-9901', amount: 4500, status: 'pending' },
        { id: '102', trackingNumber: 'TRK-B2B-4512', amount: 12500, status: 'shipped' },
        { id: '103', trackingNumber: 'TRK-B2B-0081', amount: 150, status: 'pending' },
        { id: '104', trackingNumber: 'TRK-B2B-7721', amount: 6200, status: 'cancelled' }
      ];

      // Simulated backend calculation filter engine
      const filteredResults = staticMockDatabase.filter(item => {
        const statusMatch = committedFilters.status.length ? committedFilters.status.includes(item.status as any) : true;
        const amountMatch = item.amount >= committedFilters.minAmount;
        return statusMatch && amountMatch;
      });

      setRows(filteredResults);
      setRowsLoading(false);
    }
    fetchDataset();
  }, [subType, committedFilters]);

  return { rows, rowsLoading };
}


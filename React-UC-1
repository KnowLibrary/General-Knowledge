3. Implementation Scenario A: A Page WITH Sub-Types
Here is how the Context Provider handles the internal filtering when a page relies heavily on sub-types.
Notice how views is automatically derived using useMemo based on the active currentSubType.
TypeScript
// features/orders/context/OrdersDashboardContext.tsx
import React, { createContext, useContext, useState, useMemo } from 'react';
import { DashboardContextState } from '@/types/dashboardContext';
import { SavedView } from '@/types/view';
import { OrderFilters, getFactoryDefaultsForSubType } from '../utils/orderHelpers';

const OrdersDashboardContext = createContext<DashboardContextState<OrderFilters> | undefined>(undefined);

export const OrdersDashboardProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  // 1. Raw API state array containing views across all sub-types for this screen
  const [allViews, setAllViews] = useState<SavedView<OrderFilters>>([]);
  const [currentSubType, setCurrentSubType] = useState<string>('B2B_ORDERS');
  const [activeViewId, setActiveViewId] = useState<string | null>(null);

  // Table & Filter layout states
  const [columnVisibility, setColumnVisibility] = useState({});
  const [columnOrder, setColumnOrder] = useState<string[]>([]);
  const [committedFilters, setCommittedFilters] = useState<OrderFilters>({});
  const [transientFilters, setTransientFilters] = useState<OrderFilters>({});

  // 2. PERFORMANCE/LOGIC GATE: Filter views dynamically by the active sub-type
  const views = useMemo(() => {
    return allViews.filter(view => view.screenName === 'ORDERS_PAGE' && view.subType === currentSubType);
  }, [allViews, currentSubType]);

  const activeView = useMemo(() => views.find(v => v.id === activeViewId), [views, activeViewId]);

  // 3. Orchestration Action: What happens when the user switches sub-types entirely
  const changeSubType = (newSubType: string) => {
    setCurrentSubType(newSubType);
    
    // Find the default view for this new sub-type variant
    const subTypeViews = allViews.filter(v => v.subType === newSubType);
    const defaultView = subTypeViews.find(v => v.isSystemDefault) || subTypeViews[0];

    if (defaultView) {
      setActiveViewId(defaultView.id);
      setCommittedFilters(defaultView.filters);
      setTransientFilters(defaultView.filters);
      setColumnVisibility(defaultView.columnVisibility);
      setColumnOrder(defaultView.columnOrder);
    } else {
      // Fall back to clean default layouts if no view rules are written yet
      const blankLayout = getFactoryDefaultsForSubType(newSubType);
      setActiveViewId(null);
      setCommittedFilters(blankLayout.filters);
      setTransientFilters(blankLayout.filters);
      setColumnVisibility(blankLayout.columnVisibility);
      setColumnOrder(blankLayout.columnOrder);
    }
  };

  // 4. Inject subType parameters into API creation routines
  const createNewView = async (name: string) => {
    const newViewPayload: SavedView<OrderFilters> = {
      id: Math.random().toString(),
      name,
      screenName: 'ORDERS_PAGE',
      subType: currentSubType, // Injected context level parameter
      filters: committedFilters,
      columnVisibility,
      columnOrder
    };
    setAllViews(prev => [...prev, newViewPayload]);
    setActiveViewId(newViewPayload.id);
  };

  /* Remaining CRUD methods (deleteView, saveCurrentView, etc.) operate smoothly 
     by mutating the allViews master tracker array */

  return (
    <OrdersDashboardContext.Provider value={{
      allViews, views, activeViewId, currentSubType, changeSubType, createNewView,
      committedFilters, columnVisibility, columnOrder, transientFilters, setTransientFilters,
      /* ... rest of parameters mapped */
    }}>
      {children}
    </OrdersDashboardContext.Provider>
  );
};
